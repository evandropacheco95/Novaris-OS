# Copie este arquivo para packages/database/.env e preencha com a connection
# string real do seu projeto Supabase (Project Settings → Database → Connection
# String, modo URI). Nunca commitar o arquivo .env real — já coberto por
# .gitignore na raiz do monorepo.

DATABASE_URL="postgresql://postgres:[SUA-SENHA]@[SEU-HOST].supabase.co:5432/postgres"
